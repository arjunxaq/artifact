[
  {
    "id": "86b74675-35ba-48bb-b7a4-08d18466e5b9",
    "name": "Basic Agreement",
    "html_content": "<h1>Agreement</h1>\n    <p>This agreement is between {{ party_one }} and {{ party_two }}.</p>\n    <p>Effective Date: {{ effective_date }}</p>\n    <p>Terms:</p>\n    <p>{{ terms }}</p>",
    "created_at": "2026-02-22T09:38:32.351502"
  },
  {
    "id": "56675197-4016-4cdf-a428-a1ff7a59a542",
    "name": "Rental Agreement",
    "html_content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Rental Agreement</title>\n    <style>\n        body {\n            font-family: 'Times New Roman', serif;\n            line-height: 1.6;\n            margin: 40px;\n            color: #333;\n        }\n        .header {\n            text-align: center;\n            border-bottom: 2px solid #333;\n            padding-bottom: 20px;\n            margin-bottom: 30px;\n        }\n        .header h1 {\n            font-size: 24px;\n            margin: 0;\n            text-transform: uppercase;\n        }\n        .section {\n            margin-bottom: 25px;\n        }\n        .section h2 {\n            font-size: 18px;\n            border-bottom: 1px solid #ccc;\n            padding-bottom: 5px;\n            margin-bottom: 15px;\n            color: #555;\n        }\n        .field {\n            margin-bottom: 15px;\n        }\n        .field label {\n            display: inline-block;\n            width: 200px;\n            font-weight: bold;\n        }\n        .field span {\n            display: inline-block;\n        }\n        .signature-section {\n            margin-top: 50px;\n            display: flex;\n            justify-content: space-between;\n        }\n        .signature-box {\n            width: 45%;\n            border-top: 1px solid #333;\n            padding-top: 10px;\n            text-align: center;\n        }\n        .date {\n            margin-top: 20px;\n            text-align: right;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>Residential Rental Agreement</h1>\n        <p>This Rental Agreement is made and entered into on {{ agreement_date }} by and between:</p>\n    </div>\n\n    <div class=\"section\">\n        <h2>1. Parties</h2>\n        <div class=\"field\">\n            <label>Landlord/Lessor:</label>\n            <span>{{ landlord_name }}</span>\n        </div>\n        <div class=\"field\">\n            <label>Landlord Address:</label>\n            <span>{{ landlord_address }}</span>\n        </div>\n        <div class=\"field\">\n            <label>Tenant/Lessee:</label>\n            <span>{{ tenant_name }}</span>\n        </div>\n        <div class=\"field\">\n            <label>Tenant Address:</label>\n            <span>{{ tenant_address }}</span>\n        </div>\n    </div>\n\n    <div class=\"section\">\n        <h2>2. Premises</h2>\n        <div class=\"field\">\n            <label>Property Address:</label>\n            <span>{{ property_address }}</span>\n        </div>\n        <div class=\"field\">\n            <label>Property Description:</label>\n            <span>{{ property_description }}</span>\n        </div>\n    </div>\n\n    <div class=\"section\">\n        <h2>3. Term</h2>\n        <div class=\"field\">\n            <label>Lease Term:</label>\n            <span>{{ lease_term }}</span>\n        </div>\n        <div class=\"field\">\n            <label>Start Date:</label>\n            <span>{{ start_date }}</span>\n        </div>\n        <div class=\"field\">\n            <label>End Date:</label>\n            <span>{{ end_date }}</span>\n        </div>\n    </div>\n\n    <div class=\"section\">\n        <h2>4. Rent</h2>\n        <div class=\"field\">\n            <label>Monthly Rent:</label>\n            <span>${{ monthly_rent }}</span>\n        </div>\n        <div class=\"field\">\n            <label>Due Date:</label>\n            <span>{{ rent_due_date }} of each month</span>\n        </div>\n        <div class=\"field\">\n            <label>Late Fee:</label>\n            <span>${{ late_fee }} if rent is not paid within {{ late_fee_grace_period }} days</span>\n        </div>\n    </div>\n\n    <div class=\"section\">\n        <h2>5. Security Deposit</h2>\n        <div class=\"field\">\n            <label>Security Deposit Amount:</label>\n            <span>${{ security_deposit }}</span>\n        </div>\n        <div class=\"field\">\n            <label>Deposit Return Terms:</label>\n            <span>{{ deposit_return_terms }}</span>\n        </div>\n    </div>\n\n    <div class=\"section\">\n        <h2>6. Utilities and Services</h2>\n        <div class=\"field\">\n            <label>Utilities Paid by Tenant:</label>\n            <span>{{ tenant_utilities }}</span>\n        </div>\n        <div class=\"field\">\n            <label>Utilities Paid by Landlord:</label>\n            <span>{{ landlord_utilities }}</span>\n        </div>\n    </div>\n\n    <div class=\"section\">\n        <h2>7. Maintenance and Repairs</h2>\n        <p>{{ maintenance_terms }}</p>\n    </div>\n\n    <div class=\"section\">\n        <h2>8. Use of Premises</h2>\n        <p>The premises shall be used exclusively as a private residence for the Tenant and their immediate family. The Tenant agrees to:</p>\n        <ul>\n            <li>Comply with all applicable laws, ordinances, and regulations</li>\n            <li>Not use the premises for any illegal purposes</li>\n            <li>Not disturb other tenants or neighbors</li>\n            <li>Keep the premises in good condition</li>\n        </ul>\n    </div>\n\n    <div class=\"section\">\n        <h2>9. Termination</h2>\n        <p>{{ termination_terms }}</p>\n    </div>\n\n    <div class=\"section\">\n        <h2>10. Governing Law</h2>\n        <p>This agreement shall be governed by the laws of {{ governing_law }}.</p>\n    </div>\n\n    <div class=\"section\">\n        <h2>11. Entire Agreement</h2>\n        <p>This agreement constitutes the entire understanding between the parties and supersedes all prior agreements.</p>\n    </div>\n\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <p>Landlord Signature</p>\n            <p>_______________________________</p>\n            <p>{{ landlord_name }}</p>\n            <p>Date: _________________________</p>\n        </div>\n        <div class=\"signature-box\">\n            <p>Tenant Signature</p>\n            <p>_______________________________</p>\n            <p>{{ tenant_name }}</p>\n            <p>Date: _________________________</p>\n        </div>\n    </div>\n</body>\n</html>",
    "created_at": "2026-04-08T03:28:24.882987"
  }
]